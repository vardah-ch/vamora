{
  "name": "vamora-backend",
  "version": "1.0.0",
  "description": "VAMORA (Virtual Alzheimer's Memory & Observation Recall Assistant) - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "sequelize db:create",
    "db:migrate": "sequelize db:migrate",
    "db:seed": "sequelize db:seed:all",
    "db:reset": "sequelize db:migrate:undo:all && sequelize db:migrate",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "eval:retrieval": "node eval/runRetrievalEval.js",
    "eval:companion": "node eval/runCompanionEval.js",
    "db:seed:demo": "sequelize db:seed --seed 20261113000000-demo-care-team.js",
    "vercel-build": "sequelize db:migrate && sequelize db:seed:all"
  },
  "keywords": [
    "alzheimers",
    "memory",
    "healthcare",
    "ai"
  ],
  "author": "Vardah Ahmad, Amna Khan",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "groq-sdk": "^1.1.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.0",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "uuid": "^13.0.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "embedded-postgres": "16.14.0-beta.17",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "3.7.6"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/globalSetup.js",
    "globalTeardown": "<rootDir>/test/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/test/env.js"
    ],
    "testTimeout": 30000,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/afterEnv.js"
    ]
  }
}
