# VAMORA backend configuration template. Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
# Set to true only when running behind a reverse proxy (for correct client IPs in rate limiting)
TRUST_PROXY=false

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vamora_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT – REQUIRED in production: long random strings (>= 32 chars), different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# Uploads (private directory; NOT served statically)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
MEDIA_URL_TTL_SECONDS=600

# AI companion (optional). Without GROQ_API_KEY the companion runs in retrieval-only mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=12000

# Local embeddings (free, offline after first download into .model-cache/)
EMBEDDINGS=on
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
DENSE_MIN_SIMILARITY=0.35

# Rate limits (per window; see app.js)
LOGIN_RATE_LIMIT=10
AI_RATE_LIMIT=20
REGISTER_RATE_LIMIT=20

# Development only: return password-reset tokens in the API response (no email transport yet).
DEV_EXPOSE_RESET_TOKEN=false
